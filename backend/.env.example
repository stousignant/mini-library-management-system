# Database Configuration
# PostgreSQL connection string for async operations
# Format: postgresql+asyncpg://user:password@host:port/database

# Local development database (used when ENVIRONMENT=local)
LOCAL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/library_test

# Development database (used when ENVIRONMENT=development)
DEV_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/library_dev

# Production database (used when ENVIRONMENT=production, required for prod)
# DATABASE_URL=postgresql+asyncpg://user:password@host:port/library_prod

# Override: Set DATABASE_URL to explicitly override environment-based selection
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/library_dev

# Test database (used by pytest, can be overridden)
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/library_test

# Application Configuration
PYTHONUNBUFFERED=1

# Development/Production Mode
# Options: local, development, production
ENVIRONMENT=development

# Server Configuration (optional - defaults in constants.py)
# HOST=0.0.0.0
# PORT=8000
